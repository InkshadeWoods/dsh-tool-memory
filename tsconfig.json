{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  // tests 一并纳入：否则 `npm run typecheck` 只查 src，测试侧的
  // @ts-expect-error 承重断言（见 tests/recall-reachability.spec.ts）不生效，
  // 类型门禁等于半开。2026-09-30 起生效。
  "include": ["src", "tests"]
}
